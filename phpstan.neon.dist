parameters:
    level: 1
    paths:
        - Annotation
        - Command
        - Controller
        - DependencyInjection
        - Generator
        - Grid
        - Manager
        - Mapper
        - Tests
        - Twig
        - Util
        - DtcGridBundle.php
    excludePaths:
        - vendor
        - Twig/Extension/TwigExtensionLegacy.php
includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - phpstan-baseline.neon
