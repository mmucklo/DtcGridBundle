{
    "name": "mmucklo/grid-bundle",
    "description": "Datagrid for symfony2 or symfony3 or symfony4 or symfony5",
    "keywords": ["grid", "jQGrid", "table"],
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "David Tee"
        },
        {
            "name": "Matthew J Mucklo",
            "email": "mmucklo@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.2.0",
        "symfony/framework-bundle": "^3.4 || ^4.4 || ^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/templating": "^3.4 || ^4.4 || ^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/translation": "^3.4 || ^4.4 || ^5.4 || ^6.0 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^3.4 || ^4.4 || ^5.4 || ^6.0 || ^7.0 || ^8.0",
        "twig/twig": "^2.0 || ^3.0"
    },
    "require-dev": {
        "doctrine/orm": "^2.7",
        "doctrine/annotations": "^1.13 || ^2.0",
        "doctrine/cache": "^1.11 || ^2.0",
        "doctrine/collections": "^1.6 || ^2.0",
        "doctrine/instantiator": "^1.4 || ^2.0",
        "doctrine/common": "^2.13 || ^3.0",
        "doctrine/persistence": "^1.3 || ^2.0 || ^3.0",
        "doctrine/dbal": "^2.13 || ^3.0",
        "doctrine/mongodb-odm": "^2.2",
        "phpunit/phpunit": "^8.5 || ^9.5",
        "phpstan/phpstan": "^1.10 || ^2.0",
        "phpstan/phpstan-phpunit": "^1.3 || ^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "config": {
        "bin-dir": "bin",
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": { "Dtc\\GridBundle\\": "" },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    }
}
